# ─────────────────────────────────────────────────────────────
# Configurações de API Keys para os Providers de IA
# Copie este arquivo para .env e preencha com suas chaves
# ─────────────────────────────────────────────────────────────

# =========================
# LOGGING
# =========================

# Enable or disable logging globally
LOG_ENABLED=true

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log format (reserved for future use)
LOG_FORMAT=plain

# Enable JSON structured logs
LOG_JSON=false

# Enable correlation IDs per request
LOG_CORRELATION=false


# =========================
# GOOGLE PROVIDER (Gemini)
# =========================

GOOGLE_API_KEY=your_api_key_here

# Requests allowed per window
GOOGLE_USAGE_LIMIT=80

# Window duration in seconds
GOOGLE_WINDOW_S=60

# Request timeout (seconds)
GOOGLE_TIMEOUT=60

# Max output tokens
GOOGLE_MAX_OUTPUT_TOKENS=8192


# =========================
# DEEPSEEK PROVIDER
# =========================

DEEPSEEK_API_KEY=your_deepseek_key_here

# Requests allowed per window
DEEPSEEK_USAGE_LIMIT=100

# Window duration in seconds
DEEPSEEK_WINDOW_S=60

# Request timeout (seconds) - DeepSeek pode demorar mais no modo reasoner
DEEPSEEK_TIMEOUT=120


# =========================
# GROK PROVIDER (xAI)
# =========================

GROK_API_KEY=your_grok_key_here

# Requests allowed per window
GROK_USAGE_LIMIT=60

# Window duration in seconds
GROK_WINDOW_S=60

# Request timeout (seconds)
GROK_TIMEOUT=60


# =========================
# OPENAI STYLE (optional)
# =========================

# Descomente e configure se for usar Groq, OpenAI ou outros providers compatíveis

# GROQ_API_KEY=your_groq_key_here
# GROQ_USAGE_LIMIT=60
# GROQ_WINDOW_S=60
# GROQ_TIMEOUT=30

# OPENAI_API_KEY=your_openai_key_here
# OPENAI_USAGE_LIMIT=50
# OPENAI_WINDOW_S=60
# OPENAI_TIMEOUT=30

# Max tokens para providers OpenAI-style
OPENAI_MAX_TOKENS=1024


# =========================
# OBSERVAÇÕES
# =========================
# - USAGE_LIMIT: número máximo de requisições por janela
# - WINDOW_S: duração da janela em segundos
# - TIMEOUT: timeout da requisição HTTP em segundos
# - Apenas GOOGLE_API_KEY é obrigatória por padrão
# - Outros providers são ativados apenas se suas respectivas API keys forem fornecidas




# ====================================================================





