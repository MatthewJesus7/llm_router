# =========================
# LOGGING
# =========================

# Enable or disable logging globally
LOG_ENABLED=true

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log format (reserved for future use)
LOG_FORMAT=plain


# =========================
# GOOGLE PROVIDER
# =========================

GOOGLE_API_KEY=your_api_key_here

# Requests allowed per window
GOOGLE_USAGE_LIMIT=80

# Window duration in seconds
GOOGLE_WINDOW_S=60

# Request timeout (seconds)
GOOGLE_TIMEOUT=60

# Max output tokens
GOOGLE_MAX_OUTPUT_TOKENS=8192


# =========================
# OPENAI STYLE (optional)
# =========================

OPENAI_MAX_TOKENS=1024


# =========================
# FUTURE OPTIONS
# =========================

# Enable JSON structured logs
LOG_JSON=false

# Enable correlation IDs per request
LOG_CORRELATION=false